{
  "name": "koda-cloud-backend",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Backend seguro do Koda: autenticação de admin, gestão de contas, catálogo de modelos, releases e painel administrativo",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "env": "node scripts/gerar-env.mjs",
    "hash": "node scripts/hash-senha.mjs",
    "migrate:local": "wrangler d1 migrations apply koda-cloud --local",
    "migrate:remote": "wrangler d1 migrations apply koda-cloud --remote",
    "seed:modelos": "wrangler d1 execute koda-cloud --remote --file scripts/semear-modelos.sql",
    "seed:modelos:local": "wrangler d1 execute koda-cloud --local --file scripts/semear-modelos.sql",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.138.0"
  }
}
