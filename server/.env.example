# ============================================================================
# Koda Cloud — template de ambiente
# Copie para `.env` (que está no .gitignore) e preencha. Nada aqui é segredo
# em texto puro: o que é segredo vai como HASH ou valor aleatório.
#
#   npm run hash -- --gerar     # gera senha do admin + hash + segredos
#   npm run env                 # escreve .dev.vars para o `wrangler dev`
#   npm run env -- --segredos   # envia os segredos para o Worker publicado
# ============================================================================

# ---------------------------------------------------------------------------
# Banco de dados
# No Cloudflare o banco é o binding D1 `DB` (SQLite na borda), criado com
# `wrangler d1 create koda-cloud` e versionado em `migrations/`.
# DATABASE_URL existe para deixar explícito qual banco este serviço usa.
# ---------------------------------------------------------------------------
DATABASE_URL=d1://koda-cloud

# ---------------------------------------------------------------------------
# Segredos (nunca no controle de versão, nunca em texto puro no código)
# ---------------------------------------------------------------------------
# Assina o access token (vida curta, 20 min por padrão). Mínimo de 32 caracteres.
JWT_SECRET=
# Assina o refresh token (vida longa). OBRIGATORIAMENTE diferente do JWT_SECRET.
# No banco fica só o SHA-256 do refresh — vazamento do banco não dá sessão nova.
JWT_REFRESH_SECRET=
# E-mail do administrador criado no primeiro acesso (bootstrap).
ADMIN_EMAIL=studios.ai.brasil@gmail.com
# Hash bcrypt/pbkdf2 da senha do admin. A senha em claro NUNCA entra aqui:
#   npm run hash -- "SuaSenhaForteCom12Caracteres"
# Formato aceito: $bcrypt$2b$12$... ou $pbkdf2-sha256$600000$...
ADMIN_PASSWORD_HASH=
# Chave AES-256 (32 bytes em base64) que cifra o segredo do TOTP em repouso.
TOTP_ENCRYPTION_KEY=
# Chave que o host local (c-host) apresenta em `Authorization: Bearer` para
# poder servir a API de modelos. Mora aqui de proposito: assim o binario do host
# nao carrega segredo, so a URL deste Worker. O host pergunta
# `POST /api/public/host/authorize` se a chave recebida vale.
# Vazio = ninguem entra (a rota nega tudo).
SERVE_LIZ_CLIENT_KEY=

# ---------------------------------------------------------------------------
# Ambiente e rede
# ---------------------------------------------------------------------------
# production exige HTTPS, HSTS e CORS_ORIGIN preenchido. Use development/test
# só na sua máquina.
NODE_ENV=production
# Whitelist de origens (separadas por vírgula). `tauri.localhost` é a origem do
# app desktop empacotado; a lista de admin é servida do mesmo domínio.
CORS_ORIGIN=https://tauri.localhost,http://tauri.localhost
# Libera HTTP sem redirecionar (apenas desenvolvimento local). Em produção é
# ignorado por segurança.
ALLOW_INSECURE_HTTP=false
# Liga/desliga o painel administrativo servido em /admin.
PANEL_ENABLED=true

# ---------------------------------------------------------------------------
# Sessões
# ---------------------------------------------------------------------------
# Access token: 15 a 30 minutos é a faixa recomendada (padrão: 20 min = 1200s).
ACCESS_TOKEN_TTL_S=1200
# Refresh token: dias (padrão: 7 dias). Rotação de uso único com detecção de uso
# repetido — reuso derruba a família inteira de tokens.
REFRESH_TOKEN_TTL_S=604800

# ---------------------------------------------------------------------------
# Rate limiting e lockout
# ---------------------------------------------------------------------------
# Janela geral do limitador, em ms.
RATE_LIMIT_WINDOW_MS=60000
# Teto geral por janela (rotas administrativas autenticadas).
RATE_LIMIT_MAX=120
# Teto por janela nas rotas de login.
LOGIN_RATE_LIMIT_MAX=10
# Tentativas erradas antes de travar (por IP e por conta).
LOGIN_LOCKOUT_THRESHOLD=5
# Janela em que as falhas são contadas (15 min).
LOGIN_LOCKOUT_WINDOW_MS=900000
# Quanto tempo dura o bloqueio depois de estourar (15 min).
LOGIN_LOCKOUT_DURATION_MS=900000

# ---------------------------------------------------------------------------
# Senhas e uploads
# ---------------------------------------------------------------------------
# bcrypt (padrão) ou pbkdf2. bcrypt custa CPU; em plano gratuito do Workers
# prefira pbkdf2 (Web Crypto, em C) para não estourar o tempo de CPU.
HASH_ALGO=bcrypt
# Custo do bcrypt (4 a 15). 12 é um bom equilíbrio em produção.
BCRYPT_COST=12
# Iterações do PBKDF2-SHA256 quando HASH_ALGO=pbkdf2.
PBKDF2_ITERATIONS=600000
# Tamanho máximo de arquivo aceito no upload (1 MiB). O conteúdo fica no banco,
# fora de qualquer diretório servido estaticamente.
UPLOAD_MAX_BYTES=1048576
