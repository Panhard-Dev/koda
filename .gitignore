# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Backend Python
backend/.venv
backend/data
backend/.env
__pycache__
*.pyc
.pytest_cache

# Os binários do Koda são distribuídos à parte e ficam em `host/` — não vão para o
# repositório (são grandes e binários).
host/*.exe*

# Estado local de ferramentas (memória de assistente, id de projeto)
.workbuddy-ai/
.freebuff/
.mimosa/
backend/.mimosa/
.tmp-agente/
.tmp-recuperado/
backend/.tmp-cmd/
backend/.tmp-debug/

# Testes e sondas ficam só na máquina: o repositório é de leitura, não leva teste
backend/tests/
backend/testar_*.py
backend/probe_*.py
backend/diagnostico_anexos.py

# Material de referência: o que foi lido para escrever os portes desta versão e **não** é
# código do produto. Saiu de `backend/app/tools/` na 0.6.0 (o pacote levava 325 arquivos, e
# 6 eram usados). Fica na máquina, fora do pacote e fora do repositório.
backend/trabalho/
backend/material-referencia/

# Rascunho e bancada local: nota solta, medição de disco, sandbox do pytest, relatório de
# diagnóstico. Nada disso é código do produto.
.agents/
.tmp-*
_sizes.txt
LEIA EU/
diagnostico-anexos/
backend/pytest-of-*/

# Sandbox do pytest (symlinks e projetos temporários) — não é código
backend/.pytest-local/
backend/.tmp-pytest-*/
# Diretório temporário que a suíte cria no CWD quando o pytest roda de `backend/`.
backend/tmp*/

# Backups locais de binários (o host .exe é grande e não vai para o repositório)
backups/

# Painel/backend de nuvem de uma fase anterior do produto: saiu do repositório na 0.5.1.
# Este repositório é do app de desktop, e a pasta ficou parada enquanto o resto andou.
# A cópia local é preservada (não é apagada), mas não volta para o controle de versão.
server/

# Saída solta de teste — os logs já estão cobertos por *.log acima
out.txt
err.txt

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
