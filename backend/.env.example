[TEMPLATE]
# Copie para `.env` e ajuste o que precisar. Sem nenhuma variável o backend já roda
# com o provider local (offline) e banco em data/koda.db.

# local | openai | gemini | auto
# auto = OpenAI se houver chave, senão o proxy Gemini se estiver no ar, senão local
KODA_PROVIDER=auto

# Onde o SQLite fica guardado (relativo à pasta backend/)
KODA_DATABASE_PATH=data/koda.db

# Quem pode chamar a API (separado por vírgula)
KODA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ritmo do provider local, em ms por pedaço — só para o texto parecer digitado
KODA_LOCAL_STREAM_DELAY_MS=18

# Nome com que o assistente se identifica. O host injeta uma persona própria na conversa
# (a resposta começava com "oii, eu sou a Liz, criada pela Liz AI Studio"); este é o nome
# que vale, e é ele que aparece na resposta padrão quando o modelo só sabia se apresentar.
# Ver `app/identidade.py`.
KODA_ASSISTENTE=Koda

# --- Host local (`koda/host/c-host.exe`: /v1 + tool calling + catálogo free-tier) ---
# Sem chave: só apontar. É ele que dá as ferramentas e os modelos ao seletor.
GEMINI_PROXY_URL=http://127.0.0.1:21128/v1
# Modelo padrão. Ids que o host aceita: liz-nano, liz-4, liz-3-flash, liz-mini-1-3,
# liz-mini-2, koda-1, layze-2 (veja `curl 127.0.0.1:21128/v1/models`).
GEMINI_MODEL=liz-nano
# Perfil do host (`X-Profile-Id`). Vazio deixa o host escolher a conta.
KODA_GEMINI_PROFILE=
# Painel do host, onde ele publica as contas (`/api/accounts`): é de lá que sai a
# troca de conta quando uma bate no limite. O host atual não expõe essa rota, então
# a rotação simplesmente não acontece — quem cuida das contas é o pool dele.
GEMINI_WEB_URL=http://127.0.0.1:21128

# --- Agente (ferramentas que executam de verdade na máquina) ---
# Ligado por padrão: o Koda é área de código. `off` responde sem ferramenta nenhuma.
KODA_TOOLS=on
# Pasta onde as ferramentas trabalham. Padrão: a raiz do projeto.
KODA_WORKSPACE=
# Ferramentas desligadas, separadas por vírgula. Ex.: shell,terminal,git_commit,delete_file
KODA_TOOLS_DENY=
# Desligado (padrão), as ferramentas de arquivo (read_file, write_file, edit_file,
# list_dir, delete_file, linter) só enxergam o que está dentro do KODA_WORKSPACE.
# É a proteção contra o modelo ser convencido por uma página lida na web a mexer em
# algo do sistema. Ligando (`on`), voltam a aceitar qualquer caminho absoluto.
# Atenção: `shell` e `terminal` sempre puderam tudo — é o que eles são.
KODA_ACESSO_LIVRE=off
# Teto de passos por mensagem (1 a 40)
KODA_MAX_STEPS=12
# Orçamento de tempo da tarefa inteira, em segundos (0 = sem limite)
KODA_TOOL_TIMEOUT=120
# Quanto da saída de cada ferramenta volta para o modelo e para a tela
KODA_TOOL_OUTPUT_LIMIT=4000

# --- Busca na web (`web_search`) ---
# Só o Bing, raspando a página de resultados: sem chave, sem serviço no meio e sem
# plano B. Se o Bing devolver bloqueio, a busca volta vazia.

# --- Retentativas quando quem falha é o provedor ---
# Tentativas de cada passo (cota, 5xx, 404 do upstream). O reenvio leva o histórico
# inteiro, então o modelo retoma de onde parou. Erro "de vez" (400/401) ganha uma
# segunda chance em outra conta do proxy, quando existe uma livre.
KODA_RETRY_ATTEMPTS=3
# Esgotou as tentativas? Espera essa janela de cooldown e tenta uma última vez (0 desliga).
KODA_RETRY_FINAL_WAIT_S=12

# --- Provider OpenAI-compatível (vale para OpenAI, Groq, OpenRouter, Ollama em /v1) ---
# Sem chave, o provider local entra no lugar.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Traduz os modelos da interface para os do provedor (JSON). Opcional.
# Ex.: {"liz-nano": "gpt-4o-mini", "koda-1": "gpt-4o"}
KODA_MODEL_MAP={}
