[TEMPLATE]
# Copie para `.env` e ajuste o que precisar. Sem nenhuma variável o backend já roda
# com o provider local (offline) e banco em data/koda.db.

# local | openai | host | auto
# auto = OpenAI se houver chave, senão o host com os modelos oficiais se estiver no ar,
# senão local
KODA_PROVIDER=auto

# Onde o SQLite fica guardado (relativo à pasta backend/)
KODA_DATABASE_PATH=data/koda.db

# Quem pode chamar a API (separado por vírgula)
KODA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ritmo do provider local, em ms por pedaço — só para o texto parecer digitado
KODA_LOCAL_STREAM_DELAY_MS=18

# Nome com que o assistente se identifica nas respostas. É a identidade que o backend manda
# valer e o nome que aparece na resposta padrão quando o modelo só sabia se apresentar.
# Ver `app/identidade.py`.
KODA_ASSISTENTE=Koda

# --- Host dos modelos oficiais (Liz) ---
# Endereço do host que traz o catálogo do seletor e o tool calling. É o `host/c-host.exe`,
# que o app desktop sobe sozinho ao abrir e encerra ao fechar.
HOST_URL=http://127.0.0.1:21128/v1
# Modelo padrão. O catálogo real vem do host em tempo de execução; este é só o padrão.
HOST_MODEL=liz-4

# --- Agente (ferramentas que executam de verdade na máquina) ---
# Ligado por padrão: o Koda é área de código. `off` responde sem ferramenta nenhuma.
KODA_TOOLS=on
# Pasta onde as ferramentas trabalham. Padrão: a raiz do projeto.
KODA_WORKSPACE=
# Ferramentas desligadas, separadas por vírgula. Ex.: shell,terminal,git_commit,delete_file
KODA_TOOLS_DENY=
# Desligado (padrão), as ferramentas de arquivo (read_file, write_file, edit_file,
# list_dir, delete_file, linter) só enxergam o que está dentro do KODA_WORKSPACE.
# É a proteção contra o modelo ser convencido por uma página lida na web a mexer em
# algo do sistema. Ligando (`on`), voltam a aceitar qualquer caminho absoluto.
# Atenção: `shell` e `terminal` sempre puderam tudo — é o que eles são.
KODA_ACESSO_LIVRE=off
# Teto de passos do modelo (0 = sem teto, como o projeto de origem; teto fixo trunca
# tarefa grande no meio)
KODA_MAX_STEPS=0
# Orçamento de tempo da tarefa inteira, em segundos (0 = sem limite)
KODA_TOOL_TIMEOUT_S=0
# Teto de chamadas de ferramenta por tarefa (0 = sem teto, como o projeto de origem)
KODA_MAX_TOOL_CALLS=0
# Prazo de cada chamada de ferramenta, em segundos (0 = sem teto)
KODA_TOOL_CALL_TIMEOUT_S=120
# Teto absoluto de um comando shell/terminal, em segundos (0 = sem teto)
KODA_COMANDO_TIMEOUT_S=600
# Interrompe comando sem saída após este tempo, em segundos
KODA_COMANDO_INATIVIDADE_S=300
# Devolve uma olhada do shell ao modelo a cada 4 minutos
KODA_COMANDO_OLHADA_S=240
# --- Tetos de saída das ferramentas ---
# Os padrões são os do projeto de origem (`tool_output` e `file_read_max_chars`), que é a
# referência de comportamento do Koda. Mexer aqui muda o backend inteiro.
# Quanto da saída de cada ferramenta fica na tela e no histórico
KODA_TOOL_OUTPUT_LIMIT=50000
# Teto do que uma ferramenta devolve ao modelo
KODA_TOOL_OUTPUT_MAX_BYTES=50000
# Teto de linhas de uma listagem ou busca
KODA_TOOL_OUTPUT_MAX_LINES=2000
# Teto de uma linha só, na leitura de arquivo
KODA_TOOL_OUTPUT_MAX_LINE_LENGTH=2000
# Teto de leitura de um arquivo ou anexo por vez (file_read_max_chars)
KODA_FILE_READ_MAX_CHARS=100000

# --- Busca na web (`web_search`) ---
# Só o Bing, raspando a página de resultados: sem chave, sem serviço no meio e sem
# plano B. Se o Bing devolver bloqueio, a busca volta vazia.

# --- Retentativas quando quem falha é o provedor ---
# Tentativas de cada passo (limite de uso, indisponibilidade, 404 do serviço). O reenvio
# leva o histórico inteiro, então o modelo retoma de onde parou. Erro "de vez" (400/401)
# ganha uma segunda chance em outra conta, quando o provedor expõe `rotate()`.
KODA_RETRY_ATTEMPTS=3
# Esgotou as tentativas? Espera essa janela e tenta uma última vez (0 desliga).
KODA_RETRY_FINAL_WAIT_S=12

# --- Nuvem (Koda Cloud) ---
# Backend próprio do Koda, publicado na Cloudflare. Serve para o aviso de atualização, o
# changelog e o catálogo publicado. É opcional de propósito: sem resposta da nuvem o app
# continua igual, só sem o aviso. Endereço vazio desliga tudo. Só HTTPS — em endereço
# local (localhost/127.0.0.1) o http é aceito, para desenvolvimento.
KODA_CLOUD_URL=https://koda-cloud-api.studiosluxgames.workers.dev
# Token do app na nuvem, para quando a rota exigir. Vai só no cabeçalho Authorization:
# nunca na URL, nunca em log. Deixe vazio enquanto as rotas públicas bastarem.
KODA_CLOUD_TOKEN=
# Espera máxima por resposta da nuvem, em segundos (0.5 a 30). Curto de propósito: a
# nuvem é um extra, não pode segurar a tela.
KODA_CLOUD_TIMEOUT_S=5
# stable | beta — qual canal o app segue
KODA_CLOUD_CANAL=stable
# Versão que o app compara com a publicada. Vazio usa a versão deste backend.
KODA_CLOUD_VERSAO=
# Domínios aceitos no link de download que a nuvem devolve, separados por vírgula.
# Vazio = qualquer HTTPS. Ex.: koda.app,github.com
KODA_CLOUD_DOWNLOAD_HOSTS=
# Consultar a nuvem assim que o backend sobe (on) ou só quando a tela pedir (off, padrão).
# Ligado, o app já abre com o aviso pronto; desligado, nada sai para a rede sem pedido.
KODA_CLOUD_CHECK_ON_START=off
# Pasta onde o instalador baixado é salvo. Vazio usa a pasta de downloads do sistema.
# Quem baixa o arquivo é este backend, não o navegador — o link publicado passa por
# `link_seguro` antes, e o download é um por vez (ver app/instalador.py).
KODA_DOWNLOAD_DIR=

# --- Provider OpenAI-compatível (vale para OpenAI, Groq, OpenRouter, Ollama em /v1) ---
# Sem chave, o provider local entra no lugar.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Traduz os modelos da interface para os do provedor (JSON). Opcional.
# Ex.: {"liz-nano": "gpt-4o-mini", "koda-1": "gpt-4o"}
KODA_MODEL_MAP={}
