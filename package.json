{
  "name": "koda",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && uv run uvicorn app.main:app --reload --port 8787",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "verificar": "tsc -b --pretty false && oxlint && cd backend && .venv\\Scripts\\python.exe executar-testes.py",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:host": "node scripts/verificar-host.mjs",
    "app:bundle:host": "node scripts/verificar-bundle-host.mjs",
    "app:launcher": "node scripts/criar-launcher-instalador.mjs",
    "app:runtime": "node scripts/gerar-runtime-backend.mjs",
    "app:build": "npm run app:host && npm run app:runtime && tauri build && npm run app:launcher && npm run app:bundle:host"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
